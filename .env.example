# Used by docker-compose.yml to configure the postgres, backend and
# frontend services together. Copy to `.env` before running
# `docker compose up`. This is separate from backend/.env and
# frontend/.env, which are only used for running each app outside Docker.

DB_NAME=simple_invoice
DB_USERNAME=postgres
DB_PASSWORD=postgres

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=3600

SEED_USER_EMAIL=admin@simpleinvoice.io
SEED_USER_PASSWORD=Password123!

# Must be reachable from the browser, not just from inside the Docker
# network — see the comment in frontend/Dockerfile.
VITE_API_BASE_URL=http://localhost:3000
